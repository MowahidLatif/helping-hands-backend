# Copy this file to .env and fill in your values.
# Never commit .env to git.

FLASK_APP=run.py
FLASK_ENV=development
# Set APP_ENV=production in deployed environments.
# Production startup checks are enforced when APP_ENV or FLASK_ENV is production/prod.
# APP_ENV=development
JWT_SECRET=replace-with-a-random-32-char-string
# Required in production: comma-separated allowed browser origins for API calls.
# Example: CORS_ALLOWED_ORIGINS=https://app.helpinghands.ca,https://admin.helpinghands.ca
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional override for Socket.IO CORS. If unset, CORS_ALLOWED_ORIGINS is used.
# SOCKETIO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Frontend base URL used in password reset emails.
FRONTEND_URL=http://localhost:5173

# Stripe — AWS-first: set STRIPE_SECRET_NAME for local/prod parity.
# Secret JSON should include STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET.
# STRIPE_SECRET_NAME=helpinghands/stripe
# Offline/local fallback (when STRIPE_SECRET_NAME is unset):
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_CURRENCY=cad
# Stripe Billing — create recurring Prices in Dashboard, then paste price IDs here
STRIPE_PRICE_STARTER=price_REPLACE_STARTER
STRIPE_PRICE_GROW=price_REPLACE_GROW
STRIPE_PRICE_SCALE=price_REPLACE_SCALE
STRIPE_BILLING_SUCCESS_URL=http://localhost:5173/settings/billing/success
STRIPE_BILLING_CANCEL_URL=http://localhost:5173/settings
STRIPE_BILLING_PORTAL_RETURN_URL=http://localhost:5173/settings
# Required for Stripe Connect onboarding flow
STRIPE_CONNECT_REFRESH_URL=http://localhost:5173/settings?stripe=refresh
STRIPE_CONNECT_RETURN_URL=http://localhost:5173/settings?stripe=return

# Database (AWS-first)
# Use DB_SECRET_NAME for both local and prod when possible.
# Secret JSON should include a "password" field (RDS-managed secret format).
DB_HOST=127.0.0.1
DB_PORT=65432
DB_NAME=donations_dev
DB_USER=dev
# DB_SECRET_NAME=your-secrets-manager-secret-name
# Offline/local fallback when DB_SECRET_NAME is unset:
DB_PASSWORD=dev
# Local docker postgres: disable SSL. Production RDS: verify-full + root cert.
DB_SSLMODE=disable
# DB_SSLROOTCERT=./global-bundle.pem
AWS_REGION=us-east-2

# S3 / MinIO (media uploads)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=media-dev
S3_USE_PATH_STYLE=true

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Email
FROM_EMAIL=no-reply@example.com
FROM_NAME=HelpingHands
# EMAIL_PROVIDER can be "sendgrid" or "ses".
EMAIL_PROVIDER=sendgrid
# AWS-first: set SENDGRID_SECRET_NAME and keep SENDGRID_API_KEY unset.
# Secret can be a plain string or JSON with SENDGRID_API_KEY.
# SENDGRID_SECRET_NAME=helpinghands/sendgrid
# Offline/local fallback when SENDGRID_SECRET_NAME is unset:
SENDGRID_API_KEY=SG.REPLACE_ME
# If using SES instead of SendGrid, provide AWS credentials via IAM role or env vars:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Local-only toggle: log receipt/winner emails instead of sending.
DEV_EMAIL_LOG_ONLY=1

# OpenAI (for AI site generation)
# AWS-first: set OPENAI_SECRET_NAME for local/prod parity and keep OPENAI_API_KEY unset.
# OPENAI_SECRET_NAME=your-secrets-manager-secret-name
# Offline/local fallback when OPENAI_SECRET_NAME is unset:
OPENAI_API_KEY=sk-REPLACE_ME
# Local-only webhook shortcut. Never enable in production.
DEV_STRIPE_NO_VERIFY=0
